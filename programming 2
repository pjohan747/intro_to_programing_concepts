class Beverage:
    def __init__(self, name, price):
        self.name = name
        self.price = price


class VendingMachine:
    def __init__(self):
        self.beverages = {
            "1": Beverage("Water", 1.00),
            "2": Beverage("Soda", 1.50),
            "3": Beverage("Juice", 2.00),
            "4": Beverage("Energy Drink", 2.50),
            "5": Beverage("Tea", 1.25),
            "6": Beverage("Coffee", 2.25)
        }

    def display_menu(self):
        print("\n--- VENDING MACHINE ---")
        for key, drink in self.beverages.items():
            print(key + ".", drink.name, "- $" + str(drink.price))

    def vend(self):
        while True:
            self.display_menu()

            choice = input("Select a beverage (1-6): ")

            if choice not in self.beverages:
                print("Invalid selection. Try again.")
                continue

            beverage = self.beverages[choice]

            money = input("Insert money: ")

            if money == "":
                print("Please insert money.")
                continue

            money = float(money)

            if money < beverage.price:
                print("Not enough money. Please insert $" + str(beverage.price))
                continue

            change = round(money - beverage.price, 2)

            print("Vending:", beverage.name)
            if change > 0:
                print("Change returned: $" + str(change))


# Run machine
machine = VendingMachine()
machine.vend()
