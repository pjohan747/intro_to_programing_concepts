def circle_area(pi, r):
    return pi * r * r


def total_due(money, tax):
    return money + (money * tax)


def fahrenheit_to_celsius(f):
    return (f - 32) * 5 / 9


# Area of a Circle
pi = 3.14
radius = float(input("Enter the radius: "))
print(round(circle_area(pi, radius), 2))


# Taxes
money = float(input("Enter the money amount: "))
tax_rate = input("Enter the tax rate (example: 6%): ")
tax = float(tax_rate[:-1]) / 100
print(round(total_due(money, tax), 2))


# Temperature
fahrenheit = float(input("Enter the temperature in Fahrenheit: "))
print(round(fahrenheit_to_celsius(fahrenheit), 4))
